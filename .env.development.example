# Copy this file to .env.development after cloning or pulling the project.
# It is intentionally ignored because every developer may use a different local backend.

# Must match the Vite development mode. The config rejects mismatches.
VITE_DEPLOY_ENV=development

# First-visit language for local development.
VITE_DEFAULT_LANGUAGE=zh-CN

# Optional local backend target for the Vite /api proxy. Never commit real intranet addresses.
# API_PROXY_TARGET=http://localhost:8080

# Optional AMap JS API 2.0 browser credentials for local map development.
# These values are exposed to the browser; restrict the Web key to approved referrer domains.
# VITE_AMAP_WEB_KEY=replace-with-your-web-js-api-key
# VITE_AMAP_SECURITY_JS_CODE=replace-with-your-js-security-code
