{
  "name": "quantitative-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "npm run lint && tsc -b && vite build",
    "build:staging": "npm run lint && tsc -b && vite build --mode staging",
    "build:production": "npm run lint && tsc -b && vite build --mode production",
    "lint": "oxlint && npm run lint:arithmetic && npm run lint:styles",
    "lint:arithmetic": "node scripts/check-no-private-arithmetic.mjs",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "copy-to-clipboard": "^4.0.2",
    "decimal.js": "^10.6.0",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
