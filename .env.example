# Public values shared by all environments. This file documents the committed
# .env contract; do not copy it to .env.local because that would override every mode.
# Never add secrets to variables that start with VITE_: they are exposed in the browser bundle.

# Optional application name displayed in the product shell.
VITE_APP_NAME=Quant Lab

# Public metadata rendered into index.html. Internal systems remain non-indexable by default.
VITE_APP_DESCRIPTION=Quant Lab quantitative investment workspace
VITE_ROBOTS=noindex,nofollow,noarchive

# Backend API prefix. Leave as /api when using the Vite development proxy.
VITE_API_BASE_URL=/api

# Request timeout in milliseconds. Must be a positive integer.
VITE_API_TIMEOUT=15000

# VITE_DEPLOY_ENV and VITE_DEFAULT_LANGUAGE are mode-specific. Development uses
# the ignored .env.development created from .env.development.example.
